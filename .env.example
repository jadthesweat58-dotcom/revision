# Copy to .env.local for running on your own computer. On Vercel these are set in
# Project → Settings → Environment Variables (see SETUP.md).

# The password you type to open the app.
APP_PASSWORD=choose-a-long-password

# Supabase database address. Vercel's Supabase integration adds POSTGRES_URL for you.
POSTGRES_URL=postgres://user:password@host:6543/postgres

# Optional: protects the daily background job. Vercel sends it automatically.
CRON_SECRET=
